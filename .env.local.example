# Centralized auth service — handles login and session checks.
# POST {NEXT_PUBLIC_AUTH_API_URL}/auth/login
# GET  {NEXT_PUBLIC_AUTH_API_URL}/auth/me
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5000/api/v1

# erp_backend — inventory, roles, branches, contacts, sales. It listens on
# 4100 by default (see its own .env, PORT=4100) and mounts every module
# under /api/v1, same prefix convention as the auth service.
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
